# Local-only demo. Never enable on a public production deployment.
DEMO_MODE=true
AI_PROVIDER=demo
QUOVOY_DATA_DIR=./data
# Real structured-output model (no default key)
# AI_PROVIDER=live
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Optional first organization/user bootstrap when DEMO_MODE=false.
# Supply secrets out of band, run npm run bootstrap. No default production users.
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_SALES_EMAIL=
BOOTSTRAP_SALES_PASSWORD=
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=
# Mandatory guard for a public deployment; disables even previously seeded demo sessions/users.
QUOVOY_PUBLIC_DEPLOYMENT=false
# Set these for the real HTTPS domain behind your reverse proxy.
APP_ORIGIN=
SECURE_COOKIES=false
